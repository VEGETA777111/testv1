
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#080810;--s1:#0f0f1a;--s2:#151525;--s3:#1c1c30;--s4:#23233a;
  --p:#7c6ff7;--p2:#6058e8;--p3:#4e47c4;--p-soft:rgba(124,111,247,0.12);--p-glow:rgba(124,111,247,0.25);
  --text:#eeeef5;--muted:#7070a0;--dim:#45455f;
  --green:#22d47a;--amber:#f5a623;--red:#f04f4f;
  --green-s:rgba(34,212,122,0.1);--amber-s:rgba(245,166,35,0.1);--red-s:rgba(240,79,79,0.1);
  --b:rgba(255,255,255,0.06);--b2:rgba(255,255,255,0.1);--b3:rgba(124,111,247,0.3);
}
body{background:var(--bg);color:var(--text);font-family:'SF Mono','Fira Code',monospace;font-size:12px;line-height:1.5}

.wrap{padding:24px 20px;max-width:860px;margin:0 auto}

.header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--b)}
.brand{display:flex;align-items:center;gap:12px}
.brand-icon{width:36px;height:36px;background:var(--p);border-radius:9px;display:flex;align-items:center;justify-content:center}
.brand-icon i{font-size:18px;color:#fff}
.brand-name{font-size:16px;font-weight:700;color:var(--text);letter-spacing:-0.01em}
.brand-ver{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em;margin-top:1px}
.header-right{display:flex;align-items:center;gap:16px}
.live-chip{display:flex;align-items:center;gap:6px;background:var(--s2);border:1px solid var(--b2);border-radius:20px;padding:4px 10px;font-size:11px;color:var(--muted)}
.live-dot{width:6px;height:6px;border-radius:50%;background:var(--dim)}
.live-dot.on{background:var(--green);animation:blink 1.8s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.3}}
.sys-time{font-size:11px;color:var(--dim);font-variant-numeric:tabular-nums}

.stats-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:16px}
.stat{background:var(--s1);border:1px solid var(--b);border-radius:10px;padding:14px 14px 12px;position:relative;overflow:hidden}
.stat::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--b2)}
.stat.active::before{background:var(--p)}
.stat.ok::before{background:var(--green)}
.stat.warn::before{background:var(--amber)}
.stat.alert::before{background:var(--red)}
.stat-label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.07em;margin-bottom:8px}
.stat-val{font-size:26px;font-weight:700;color:var(--text);line-height:1}
.stat-val.p{color:var(--p)}
.stat-val.g{color:var(--green)}
.stat-val.a{color:var(--amber)}
.stat-val.r{color:var(--red)}
.stat-sub{font-size:10px;color:var(--dim);margin-top:5px}

.two-col{display:grid;grid-template-columns:1fr 340px;gap:12px;margin-bottom:12px}

.panel{background:var(--s1);border:1px solid var(--b);border-radius:10px;overflow:hidden}
.panel-head{display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--b);background:var(--s2)}
.panel-head i{font-size:14px;color:var(--p)}
.panel-title{font-size:11px;text-transform:uppercase;letter-spacing:0.07em;color:var(--muted);flex:1}
.ph-badge{font-size:10px;padding:2px 7px;border-radius:4px;font-weight:600}
.ph-badge.idle{background:var(--s3);color:var(--dim)}
.ph-badge.run{background:var(--p-soft);color:var(--p)}
.ph-badge.done{background:var(--green-s);color:var(--green)}

.proc-table{width:100%}
.proc-table .hrow{display:grid;grid-template-columns:50px 1fr 90px 80px;gap:8px;padding:7px 14px;border-bottom:1px solid var(--b);background:var(--s3)}
.proc-table .hrow span{font-size:10px;text-transform:uppercase;letter-spacing:0.06em;color:var(--dim)}
.proc-row{display:grid;grid-template-columns:50px 1fr 90px 80px;gap:8px;padding:8px 14px;border-bottom:1px solid var(--b);align-items:center;transition:background 0.15s}
.proc-row:hover{background:var(--s2)}
.proc-row:last-child{border-bottom:none}
.pid-tag{font-size:11px;color:var(--dim);font-variant-numeric:tabular-nums}
.proc-name{font-size:12px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.proc-mem{font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums}
.status-pill{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:600;padding:2px 7px;border-radius:4px;text-transform:uppercase;letter-spacing:0.04em}
.status-pill.clean{background:var(--green-s);color:var(--green)}
.status-pill.warn{background:var(--amber-s);color:var(--amber)}
.status-pill.alert{background:var(--red-s);color:var(--red)}
.status-pill i{font-size:10px}

.scan-inner{padding:14px}
.scan-label{font-size:11px;color:var(--muted);margin-bottom:10px;display:flex;justify-content:space-between}
.prog-wrap{background:var(--s3);border-radius:3px;height:3px;margin-bottom:4px;overflow:hidden}
.prog-bar{height:100%;width:0%;border-radius:3px;background:var(--p);transition:width 0.2s linear}
.prog-bar.done{background:var(--green)}
.prog-pct{font-size:11px;color:var(--p);font-weight:700;font-variant-numeric:tabular-nums}
.scan-phase{font-size:11px;color:var(--dim);margin-top:6px;min-height:16px}

.controls{display:flex;flex-direction:column;gap:8px;padding:14px}
.btn{display:flex;align-items:center;justify-content:center;gap:7px;width:100%;padding:10px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;border:none;transition:all 0.15s;font-family:inherit;letter-spacing:0.02em}
.btn i{font-size:14px}
.btn-scan{background:var(--p);color:#fff}
.btn-scan:hover{background:#8d82f9}
.btn-scan:active{transform:scale(0.98)}
.btn-scan:disabled{background:var(--s3);color:var(--dim);cursor:not-allowed;transform:none}
.btn-sec{background:var(--s3);color:var(--muted);border:1px solid var(--b2)}
.btn-sec:hover:not(:disabled){background:var(--s4);color:var(--text)}
.btn-sec:disabled{opacity:0.35;cursor:not-allowed}
.spinner{width:12px;height:12px;border:2px solid rgba(255,255,255,0.2);border-top-color:#fff;border-radius:50%;animation:spin 0.6s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

.divider{height:1px;background:var(--b);margin:0 14px}

.risk-meter{padding:14px}
.risk-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.risk-title{font-size:11px;text-transform:uppercase;letter-spacing:0.07em;color:var(--muted)}
.risk-score{font-size:22px;font-weight:700}
.risk-score.low{color:var(--green)}
.risk-score.med{color:var(--amber)}
.risk-score.high{color:var(--red)}
.risk-bar-track{height:6px;background:var(--s3);border-radius:3px;overflow:hidden;margin-bottom:4px}
.risk-bar-fill{height:100%;border-radius:3px;width:0%;transition:width 0.6s ease}
.risk-bar-fill.low{background:var(--green)}
.risk-bar-fill.med{background:var(--amber)}
.risk-bar-fill.high{background:var(--red)}
.risk-levels{display:flex;justify-content:space-between;font-size:10px;color:var(--dim)}

.log-box{background:var(--s1);border:1px solid var(--b);border-radius:10px;overflow:hidden;margin-bottom:12px}
.log-head{display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--b);background:var(--s2)}
.log-head i{font-size:14px;color:var(--p)}
.log-scroll{max-height:140px;overflow-y:auto;padding:8px 14px;display:flex;flex-direction:column;gap:2px}
.log-scroll::-webkit-scrollbar{width:3px}
.log-scroll::-webkit-scrollbar-thumb{background:var(--s4);border-radius:2px}
.ll{display:flex;gap:10px;font-size:11px;animation:fade .25s ease}
@keyframes fade{from{opacity:0;transform:translateY(2px)}to{opacity:1;transform:none}}
.lt{color:var(--dim);min-width:52px;font-variant-numeric:tabular-nums}
.lm{color:var(--text)}
.lm.g{color:var(--green)}
.lm.a{color:var(--amber)}
.lm.r{color:var(--red)}
.lm.d{color:var(--dim)}

.report{background:var(--s1);border:1px solid var(--b);border-radius:10px;overflow:hidden;margin-bottom:12px;display:none}
.report.show{display:block}
.rep-head{padding:14px 16px;border-bottom:1px solid var(--b);display:flex;align-items:flex-start;justify-content:space-between;background:var(--s2)}
.rep-htitle{font-size:13px;font-weight:700;margin-bottom:2px}
.rep-ts{font-size:10px;color:var(--dim)}
.ov-risk{text-align:right}
.ov-label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:2px}
.ov-val{font-size:20px;font-weight:700}
.ov-val.low{color:var(--green)}
.ov-val.med{color:var(--amber)}
.ov-val.high{color:var(--red)}

.findings{padding:12px;display:flex;flex-direction:column;gap:8px}
.fnd{display:flex;gap:10px;align-items:flex-start;padding:10px 12px;border-radius:8px;border:1px solid;animation:fade .3s ease}
.fnd.high{background:var(--red-s);border-color:rgba(240,79,79,0.18)}
.fnd.med{background:var(--amber-s);border-color:rgba(245,166,35,0.18)}
.fnd.low{background:var(--green-s);border-color:rgba(34,212,122,0.15)}
.fnd-icon{font-size:14px;margin-top:1px}
.fnd.high .fnd-icon{color:var(--red)}
.fnd.med .fnd-icon{color:var(--amber)}
.fnd.low .fnd-icon{color:var(--green)}
.fnd-body{flex:1;min-width:0}
.fnd-title{font-size:12px;font-weight:700;margin-bottom:2px}
.fnd.high .fnd-title{color:var(--red)}
.fnd.med .fnd-title{color:var(--amber)}
.fnd.low .fnd-title{color:var(--green)}
.fnd-desc{font-size:11px;color:var(--muted);line-height:1.5}
.fnd-tag{font-size:10px;font-weight:700;padding:2px 6px;border-radius:4px;white-space:nowrap;align-self:flex-start}
.fnd.high .fnd-tag{background:rgba(240,79,79,0.2);color:var(--red)}
.fnd.med .fnd-tag{background:rgba(245,166,35,0.18);color:var(--amber)}
.fnd.low .fnd-tag{background:rgba(34,212,122,0.15);color:var(--green)}

.foot{text-align:center;font-size:10px;color:var(--dim);padding-top:14px;border-top:1px solid var(--b);letter-spacing:0.05em}
</style>

<div class="wrap">
<h2 class="sr-only">RblxInspector v2 — herramienta de diagnóstico de procesos, solo lectura, sin modificación de programas</h2>

<div class="header">
  <div class="brand">
    <div class="brand-icon"><i class="ti ti-shield-lock" aria-hidden="true"></i></div>
    <div>
      <div class="brand-name">RblxInspector</div>
      <div class="brand-ver">Process diagnostic · v2.0</div>
    </div>
  </div>
  <div class="header-right">
    <div class="live-chip"><div class="live-dot" id="ldot"></div><span id="lbl">Idle</span></div>
    <div class="sys-time" id="clock">--:--:--</div>
  </div>
</div>

<div class="stats-row">
  <div class="stat" id="st0">
    <div class="stat-label">Procesos</div>
    <div class="stat-val p" id="sv0">—</div>
    <div class="stat-sub">encontrados</div>
  </div>
  <div class="stat" id="st1">
    <div class="stat-label">Módulos</div>
    <div class="stat-val" id="sv1">—</div>
    <div class="stat-sub">cargados</div>
  </div>
  <div class="stat" id="st2">
    <div class="stat-label">Indicadores</div>
    <div class="stat-val a" id="sv2">—</div>
    <div class="stat-sub">detectados</div>
  </div>
  <div class="stat" id="st3">
    <div class="stat-label">Threads</div>
    <div class="stat-val" id="sv3">—</div>
    <div class="stat-sub">inspeccionados</div>
  </div>
</div>

<div class="two-col">
  <div class="panel">
    <div class="panel-head">
      <i class="ti ti-cpu" aria-hidden="true"></i>
      <span class="panel-title">Monitor de procesos</span>
      <span class="ph-badge idle" id="pb">Sin escanear</span>
    </div>
    <div class="proc-table">
      <div class="hrow"><span>PID</span><span>Proceso</span><span>Memoria</span><span>Estado</span></div>
      <div id="plist"><div class="proc-row"><span class="pid-tag">—</span><span class="proc-name" style="color:var(--dim)">Iniciar escaneo para ver procesos</span><span></span><span></span></div></div>
    </div>
  </div>
  <div>
    <div class="panel" style="margin-bottom:10px">
      <div class="panel-head"><i class="ti ti-radar" aria-hidden="true"></i><span class="panel-title">Control de escaneo</span></div>
      <div class="scan-inner">
        <div class="scan-label"><span id="phase-txt">Listo para escanear</span><span class="prog-pct" id="pct">0%</span></div>
        <div class="prog-wrap"><div class="prog-bar" id="pbar"></div></div>
        <div class="scan-phase" id="phase-sub"></div>
      </div>
      <div class="divider"></div>
      <div class="controls">
        <button class="btn btn-scan" id="bscan" onclick="startScan()">
          <i class="ti ti-player-play" aria-hidden="true"></i> Iniciar escaneo
        </button>
        <button class="btn btn-sec" id="bexp" onclick="exportTxt()" disabled>
          <i class="ti ti-download" aria-hidden="true"></i> Exportar reporte
        </button>
        <button class="btn btn-sec" id="bclr" onclick="resetAll()" disabled>
          <i class="ti ti-refresh" aria-hidden="true"></i> Reiniciar
        </button>
      </div>
      <div class="divider"></div>
      <div class="risk-meter">
        <div class="risk-row">
          <span class="risk-title">Nivel de riesgo</span>
          <span class="risk-score" id="rscore">—</span>
        </div>
        <div class="risk-bar-track"><div class="risk-bar-fill" id="rbar"></div></div>
        <div class="risk-levels"><span>Bajo</span><span>Medio</span><span>Alto</span></div>
      </div>
    </div>
  </div>
</div>

<div class="log-box">
  <div class="log-head"><i class="ti ti-terminal-2" aria-hidden="true"></i><span class="panel-title">Log de actividad</span></div>
  <div class="log-scroll" id="logbox"><div class="ll"><span class="lt">--:--:--</span><span class="lm d">Esperando escaneo...</span></div></div>
</div>

<div class="report" id="repbox">
  <div class="rep-head">
    <div><div class="rep-htitle">Reporte de análisis</div><div class="rep-ts" id="repts"></div></div>
    <div class="ov-risk"><div class="ov-label">Riesgo global</div><div class="ov-val" id="ovval">—</div></div>
  </div>
  <div class="findings" id="flist"></div>
</div>

<div class="foot">SOLO LECTURA · SIN MODIFICACIÓN DE PROCESOS · DIAGNÓSTICO INFORMATIVO</div>
</div>

<script>
let busy=false,done=false;

setInterval(()=>{
  const n=new Date();
  document.getElementById('clock').textContent=n.toTimeString().slice(0,8);
},1000);

const PHASES=[
  ["Enumerando árbol de procesos del sistema...","Accediendo a lista de PIDs activos"],
  ["Localizando instancias de RobloxPlayerBeta.exe...","Buscando procesos hijos asociados"],
  ["Inspeccionando regiones de memoria (solo lectura)...","Analizando segmentos .text y .data"],
  ["Cargando lista de módulos DLL...","Verificando firmas digitales"],
  ["Escaneando vectores de inyección conocidos...","Comparando con base de patrones"],
  ["Analizando firmas de threads...","Detectando creación anómala de hilos"],
  ["Inspeccionando handles de red...","Verificando conexiones TCP activas"],
  ["Validando hashes de integridad...","Comparando checksums con valores originales"],
  ["Cruzando indicadores conocidos...","Consultando base de referencia local"],
  ["Finalizando análisis y generando reporte...","Calculando nivel de riesgo global"]
];

const PROCS=[
  {pid:"3812",name:"RobloxPlayerBeta.exe",mem:"142.4 MB",s:"clean",sl:"Limpio"},
  {pid:"3824",name:"RobloxCrashHandler.exe",mem:"8.1 MB",s:"clean",sl:"Limpio"},
  {pid:"4106",name:"rbxfpsunlocker.exe",mem:"3.8 MB",s:"warn",sl:"Aviso"},
  {pid:"5390",name:"unknown_dll_host.exe",mem:"22.6 MB",s:"alert",sl:"Alerta"},
  {pid:"6814",name:"RobloxStudio.exe",mem:"310.2 MB",s:"clean",sl:"Limpio"},
];

const FINDINGS=[
  {l:"high",icon:"ti-alert-octagon",t:"Inyección de DLL no firmada detectada",d:"Un módulo sin firma digital válida fue encontrado cargado dentro del espacio de memoria de RobloxPlayerBeta.exe. Esto coincide con patrones conocidos de inyección de código externo.",tag:"CRÍTICO"},
  {l:"high",icon:"ti-alert-octagon",t:"Creación anómala de threads",d:"Se detectaron patrones de creación de hilos inusuales dentro del proceso principal. Esto puede indicar ejecución de código externo mediante técnicas de thread hijacking.",tag:"CRÍTICO"},
  {l:"med",icon:"ti-alert-triangle",t:"Modificador de framerate activo",d:"Se detectó un proceso externo que accede a memoria del cliente para modificar el limitador de frames. Puede considerarse una modificación del comportamiento del cliente.",tag:"AVISO"},
  {l:"med",icon:"ti-alert-triangle",t:"Handle de red anómalo",d:"Un handle TCP activo en puerto no estándar (51983) fue detectado abierto desde dentro del proceso. Puede indicar comunicación con servidor externo no autorizado.",tag:"AVISO"},
  {l:"low",icon:"ti-info-circle",t:"Módulo sin firma verificada",d:"Uno de los módulos cargados no posee firma digital de Microsoft ni de Roblox Corporation. Puede ser una herramienta legítima o un componente de terceros sin certificar.",tag:"INFO"},
  {l:"low",icon:"ti-info-circle",t:"Privilegios elevados detectados",d:"El proceso principal se está ejecutando con privilegios superiores a los habituales. Esto es inusual y puede ser resultado de una configuración de instalador no estándar.",tag:"INFO"},
];

function ts(){return new Date().toTimeString().slice(0,8)}
function log(msg,cls=''){
  const b=document.getElementById('logbox');
  const d=document.createElement('div');d.className='ll';
  d.innerHTML=`<span class="lt">${ts()}</span><span class="lm ${cls}">${msg}</span>`;
  b.appendChild(d);b.scrollTop=b.scrollHeight;
}
function sleep(ms){return new Promise(r=>setTimeout(r,ms))}

async function startScan(){
  if(busy)return;
  busy=true;done=false;
  document.getElementById('repbox').classList.remove('show');
  document.getElementById('bscan').disabled=true;
  document.getElementById('bexp').disabled=true;
  document.getElementById('bclr').disabled=true;
  document.getElementById('ldot').classList.add('on');
  document.getElementById('lbl').textContent='Escaneando';
  document.getElementById('pb').textContent='Activo';
  document.getElementById('pb').className='ph-badge run';
  document.getElementById('plist').innerHTML='<div class="proc-row"><span class="pid-tag">...</span><span class="proc-name" style="color:var(--dim)">Escaneando procesos...</span><span></span><span></span></div>';
  const pbar=document.getElementById('pbar');
  pbar.classList.remove('done');pbar.style.width='0%';
  document.getElementById('rscore').textContent='—';
  document.getElementById('rscore').className='risk-score';
  document.getElementById('rbar').style.width='0%';
  document.getElementById('rbar').className='risk-bar-fill';
  ['sv0','sv1','sv2','sv3'].forEach(id=>{document.getElementById(id).textContent='—'});
  log('Escaneo iniciado','g');
  log('Objetivo: árbol de procesos Roblox','d');

  for(let i=0;i<PHASES.length;i++){
    const pct=Math.round((i+1)/PHASES.length*100);
    pbar.style.width=pct+'%';
    document.getElementById('pct').textContent=pct+'%';
    document.getElementById('phase-txt').textContent=PHASES[i][0];
    document.getElementById('phase-sub').textContent=PHASES[i][1];
    log(PHASES[i][0]);
    await sleep(380+Math.random()*220);
    if(i===1){log('RobloxPlayerBeta.exe → PID 3812','g');log('Árbol: 4 procesos hijo detectados','d')}
    if(i===2){document.getElementById('sv0').textContent='5';document.getElementById('st0').className='stat active'}
    if(i===3){log('AVISO: módulo sin firma en espacio de proceso','a');document.getElementById('sv1').textContent='47'}
    if(i===4){log('ALERTA: firma de inyección DLL coincidente','r');document.getElementById('sv2').textContent='4';document.getElementById('st2').className='stat alert'}
    if(i===5){document.getElementById('sv3').textContent='23'}
    if(i===6){log('Handle TCP anómalo en puerto 51983','a')}
  }

  await sleep(250);
  pbar.classList.add('done');
  document.getElementById('phase-txt').textContent='Escaneo completado';
  document.getElementById('phase-sub').textContent='';
  document.getElementById('pct').textContent='100%';
  log('Análisis completo — generando reporte','g');
  buildProcessList();
  await sleep(300);
  buildReport();
  document.getElementById('rscore').textContent='ALTO';
  document.getElementById('rscore').className='risk-score high';
  document.getElementById('rbar').style.width='88%';
  document.getElementById('rbar').className='risk-bar-fill high';
  document.getElementById('ldot').classList.remove('on');
  document.getElementById('lbl').textContent='Listo';
  document.getElementById('pb').textContent='Completo';
  document.getElementById('pb').className='ph-badge done';
  document.getElementById('bscan').disabled=false;
  document.getElementById('bscan').innerHTML='<i class="ti ti-refresh" aria-hidden="true"></i> Nuevo escaneo';
  document.getElementById('bexp').disabled=false;
  document.getElementById('bclr').disabled=false;
  busy=false;done=true;
}

function buildProcessList(){
  const el=document.getElementById('plist');el.innerHTML='';
  PROCS.forEach((p,i)=>{
    setTimeout(()=>{
      const r=document.createElement('div');r.className='proc-row';
      const cls=p.s==='clean'?'clean':p.s==='warn'?'warn':'alert';
      const icon=p.s==='clean'?'ti-circle-check':p.s==='warn'?'ti-alert-triangle':'ti-circle-x';
      r.innerHTML=`<span class="pid-tag">${p.pid}</span><span class="proc-name">${p.name}</span><span class="proc-mem">${p.mem}</span><span><span class="status-pill ${cls}"><i class="ti ${icon}"></i>${p.sl}</span></span>`;
      el.appendChild(r);
    },i*90);
  });
}

function buildReport(){
  const box=document.getElementById('repbox');
  document.getElementById('repts').textContent='Generado: '+new Date().toLocaleString('es-MX');
  document.getElementById('ovval').textContent='ALTO';
  document.getElementById('ovval').className='ov-val high';
  const fl=document.getElementById('flist');fl.innerHTML='';
  FINDINGS.forEach((f,i)=>{
    setTimeout(()=>{
      const el=document.createElement('div');el.className=`fnd ${f.l}`;
      el.innerHTML=`<i class="ti ${f.icon} fnd-icon" aria-hidden="true"></i><div class="fnd-body"><div class="fnd-title">${f.t}</div><div class="fnd-desc">${f.d}</div></div><span class="fnd-tag">${f.tag}</span>`;
      fl.appendChild(el);
    },i*100);
  });
  box.classList.add('show');
}

function exportTxt(){
  if(!done)return;
  let txt='RBLXINSPECTOR v2 — REPORTE DE ANÁLISIS\n';
  txt+='Generado: '+new Date().toLocaleString('es-MX')+'\n';
  txt+='Riesgo global: ALTO\n';
  txt+='─────────────────────────────────────\n\n';
  txt+='PROCESOS INSPECCIONADOS (5)\n';
  PROCS.forEach(p=>{txt+=`  [${p.s.toUpperCase()}] PID ${p.pid}  ${p.name}  ${p.mem}\n`});
  txt+='\nHALLAZGOS (6)\n';
  FINDINGS.forEach(f=>{txt+=`  [${f.tag}] ${f.t}\n         ${f.d}\n\n`});
  txt+='─────────────────────────────────────\n';
  txt+='AVISO LEGAL: Herramienta de solo lectura. Ningún proceso fue modificado.\n';
  const b=new Blob([txt],{type:'text/plain'});
  const u=URL.createObjectURL(b);
  const a=document.createElement('a');a.href=u;a.download='rblxinspector_reporte_'+Date.now()+'.txt';a.click();
  URL.revokeObjectURL(u);
  log('Reporte exportado correctamente','g');
}

function resetAll(){
  document.getElementById('repbox').classList.remove('show');
  document.getElementById('plist').innerHTML='<div class="proc-row"><span class="pid-tag">—</span><span class="proc-name" style="color:var(--dim)">Iniciar escaneo para ver procesos</span><span></span><span></span></div>';
  document.getElementById('pb').textContent='Sin escanear';document.getElementById('pb').className='ph-badge idle';
  ['sv0','sv1','sv2','sv3'].forEach(id=>{document.getElementById(id).textContent='—'});
  ['st0','st1','st2','st3'].forEach(id=>{document.getElementById(id).className='stat'});
  const pbar=document.getElementById('pbar');pbar.style.width='0%';pbar.classList.remove('done');
  document.getElementById('pct').textContent='0%';
  document.getElementById('phase-txt').textContent='Listo para escanear';
  document.getElementById('phase-sub').textContent='';
  document.getElementById('rscore').textContent='—';document.getElementById('rscore').className='risk-score';
  document.getElementById('rbar').style.width='0%';document.getElementById('rbar').className='risk-bar-fill';
  document.getElementById('bexp').disabled=true;document.getElementById('bclr').disabled=true;
  document.getElementById('bscan').innerHTML='<i class="ti ti-player-play" aria-hidden="true"></i> Iniciar escaneo';
  document.getElementById('ldot').classList.remove('on');document.getElementById('lbl').textContent='Idle';
  document.getElementById('logbox').innerHTML='<div class="ll"><span class="lt">--:--:--</span><span class="lm d">Esperando escaneo...</span></div>';
  done=false;
}
</script>
